DJANGO_SECRET_KEY='CHANGE_ME_SECRET'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

DB_HOST=db
DB_PORT=3306
DB_PUBLISHED_PORT=3308
DB_NAME=job_data
DB_USER=user
DB_PASSWORD='CHANGE_ME_DB_PASSWORD'
DB_ROOT_PASSWORD='CHANGE_ME_DB_ROOT_PASSWORD'

REDIS_URL=redis://redis:6379/0
API_INTERNAL_TOKEN='CHANGE_ME_INTERNAL_TOKEN'
TZ=Asia/Seoul

# Optional GPT parser for job-posting extraction.
# Development: set these to your GPT development account/project values.
# Production: inject separate production credentials at deploy time.
OPENAI_PARSER_ENABLED=0
OPENAI_API_KEY=
# Optional OpenAI Platform project id. Leave blank to use the API key's default project.
OPENAI_PROJECT_ID=
# Backward-compatible alias; prefer OPENAI_PROJECT_ID for new setups.
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Allows /api-test/ to send a one-off API key for local smoke tests only.
# Defaults to 1 when DJANGO_DEBUG=True and 0 otherwise.
OPENAI_ALLOW_REQUEST_API_KEY=1

# 이미지 태그/다이제스트(있다면)
PYTHON_BASE_IMAGE=python:3.10-slim
PYTHON_BASE_DIGEST=sha256:CHANGE_ME
MARIADB_TAG=mariadb:10.5
MARIADB_DIGEST=sha256:CHANGE_ME
REDIS_TAG=redis:6.2-alpine
REDIS_DIGEST=sha256:CHANGE_ME
